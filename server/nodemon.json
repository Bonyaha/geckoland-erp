{
	"watch": [
		"src/**/*"
	],
	"ignore": [
		"src/storage/gmail-history.json",
		"src/config/credentials/**/*",
		"src/storage/.rozetka-token-cache.json",
		"node_modules/**/*",
		"dist/**/*",
		"logs/**/*",
		".cron-initialized"
	],
	"ext": "ts,js,json",
	"exec": "tsx --env-file=.env src/index.ts"
}